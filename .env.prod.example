# Production Environment Variables
# Copy this file to .env.prod and fill in real values

# Database
POSTGRES_USER=teleconsult
POSTGRES_PASSWORD=CHANGE_THIS_STRONG_PASSWORD
POSTGRES_DB=teleconsult
POSTGRES_PORT=5432

# Redis
REDIS_PASSWORD=CHANGE_THIS_REDIS_PASSWORD
REDIS_PORT=6379

# RabbitMQ
RABBITMQ_USER=teleconsult
RABBITMQ_PASSWORD=CHANGE_THIS_RABBITMQ_PASSWORD
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672

# JWT
JWT_SECRET=CHANGE_THIS_SUPER_SECRET_KEY_MIN_32_CHARS
JWT_REFRESH_SECRET=CHANGE_THIS_REFRESH_SECRET_KEY_MIN_32_CHARS

# Midtrans
MIDTRANS_SERVER_KEY=your-production-server-key
MIDTRANS_CLIENT_KEY=your-production-client-key
MIDTRANS_IS_PRODUCTION=true

# Agora
AGORA_APP_ID=your-agora-app-id
AGORA_APP_CERTIFICATE=your-agora-certificate

# Ports
BACKEND_PORT=3001
FRONTEND_PORT=3000

# URLs
FRONTEND_URL=https://your-domain.com
NEXT_PUBLIC_API_URL=https://api.your-domain.com/api
